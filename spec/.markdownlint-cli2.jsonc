// markdownlint-cli2 config for the V* specification tree.
//
// Scoped to spec/: markdownlint-cli2 resolves its config from the
// working directory, and `make lint-spec` runs from here so the spec
// prose is linted on its own rules without imposing them on the
// monorepo's other markdown.
//
// We lint prose for genuine quality issues but permit:
//   - long lines (specs cite full URLs and RFC section references;
//     wrapping hurts diffability)
//   - inline HTML (GitHub alert blocks > [!WARNING] and similar)
//   - non-aligned tables (mapping tables carry long cell content;
//     forcing column alignment churns the file every time a row grows)
//   - missing blank line around headings/lists (Keep-a-Changelog style
//     packs `### Added` directly above its list)
//   - fenced blocks without a language: the spec uses unlabeled fences
//     for iCalendar/vCard content lines and grammar snippets, not code
//
// Per-version CHANGELOG.md files are generated by release-please and
// are not linted.
{
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD060": false,
    "MD022": false,
    "MD032": false,
    "MD040": false
  },
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "node_modules",
    "v*/CHANGELOG.md"
  ]
}
